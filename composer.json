{
    "name": "fiber-interop/curl",
    "description": "Cooperative curl_exec() for fiber-interop/api: fiber\\curl\\exec() and start() on any adapter, with native drivers where the runtime has one.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "fiber-interop/api": "^0.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11",
        "fiber-interop/revolt": "*",
        "fiber-interop/amp": "*",
        "fiber-interop/react": "*",
        "fiber-interop/phasync": "*",
        "fiber-interop/swoole": "*"
    },
    "autoload": {
        "psr-4": {
            "fiber\\curl\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "fiber\\curl\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../api",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../scope",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../revolt",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../amp",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../react",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../phasync",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../swoole",
            "options": {
                "symlink": true
            }
        }
    ]
}
